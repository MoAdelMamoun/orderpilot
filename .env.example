# OrderPilot configuration — ALL OPTIONAL.
# The demo runs with ZERO config: no token, no network. Copy this to `.env`
# only if you are enabling the FULL (live) Telegram version.

# --- Live Telegram bot --------------------------------------------------------
# Leave EMPTY for the demo. The live Telegram bot stays OFF unless this is set.
# Get a token from @BotFather, then run:  python -m orderpilot.telegram_bot
TELEGRAM_BOT_TOKEN=

# --- Optional overrides (sensible defaults already used by the demo) ----------
# The fictional shop name shown throughout the UI.
ORDERPILOT_SHOP_NAME=Acme Coffee Co.

# Where the SQLite database lives (defaults to ./orderpilot_demo.db).
ORDERPILOT_DB_PATH=
